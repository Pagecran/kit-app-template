[package]
authors = ["Kit Team"]
category = "farm-jobs"
changelog = """
# Changelog

## [0.1.0] - 2021-06-14
- Initial release

"""
description = "Omniverse Agent Hello World Job"
readme = "Omniverse Agent Hello World Job"
title = "Omniverse Agent Hello World Job"
version = "0.1.0"

keywords = ["job"]

[dependencies]
"omni.services.render" = {}
"omni.services.farm.agent.runner" = {}
# This is currently hardcoded in Create as a dependency. make sure to align.
"omni.services.transport.client.http_async" = { version = "1.3.1"}

[job.create-render]
name = "create-render"
job_type = "kit-service"
command = "D:\\NVIDIA-Omniverse\\kit-app-template\\_build\\windows-x86_64\\release\\kit\\kit.exe"
args = [
    "D:\\NVIDIA-Omniverse\\kit-app-template\\_build\\windows-x86_64\\release\\apps\\pagerender.usd_compose.kit",
    "--enable omni.services.render",
    "--/renderer/enabled=pxr",
    "--/rtx/enabled=false"
]
task_function = "render.run"
log_to_stdout = true
job_spec_path = ""
headless = false
active = true
success_return_codes = [ 0,]
working_directory = ""
container = ""

[job.create-render.env]

[job.create-render.allowed_args]

[job.create-render.capacity_requirements]
