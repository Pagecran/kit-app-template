[package]
authors = ["Kit Team"]
category = "farm-jobs"
changelog = """
# Changelog

## [0.1.0] - 2021-06-14
- Initial release

"""
description = "Omniverse Agent Render Job"
readme = "Omniverse Agent Render Job"
title = "Omniverse Agent Render Job"
version = "0.1.0"

keywords = ["job"]

[dependencies]
"omni.services.render" = {}
"omni.services.farm.agent.runner" = {}
# This is currently hardcoded in Create as a dependency. make sure to align.
"omni.services.transport.client.http_async" = { version = "1.3.1"}

[job.create-render]
job_type = "kit-service"
name = "create-render"
command = "D:\\NVIDIA-Omniverse\\kit-app-template\\_build\\windows-x86_64\\release\\kit\\kit.exe"
args = [
    "D:\\NVIDIA-Omniverse\\kit-app-template\\_build\\windows-x86_64\\release\\apps\\pagerender.usd_compose.kit",
    "--enable omni.hydra.rtx",
    "--enable omni.services.core",
    "--enable omni.services.render",
    "--enable omni.services.farm.agent.runner",
    "--/app/content/emptyStageOnStart=true",
    "--/app/file/ignoreUnsavedOnExit=true",
    "--/app/asyncRendering=false",
    "--/app/extensions/excluded/0=omni.kit.window.privacy",
    "--/app/hangDetector/enabled=0",
    "--/rtx/materialDb/syncLoads=true",
    "--/omni.kit.plugin/syncUsdLoads=true",
    "--/rtx/hydra/materialSyncLoads=true",
    "--/rtx-transient/resourcemanager/texturestreaming/async=false",
    "--/rtx-transient/resourcemanager/enableTextureStreaming=false",
    "--/exts/omni.kit.window.viewport/blockingGetViewportDrawable=true",
    "--/rtx-transient/dlssg/enabled=false"
]
task_function = "render.run"
headless = false
env = { "HOME" = "C:\\Users\\p-andre" }
log_to_stdout = true
